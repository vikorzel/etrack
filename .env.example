# --- Режим 1: загрузка конфига и секрета из PocketBase (если PB_CONFIG_HOST задан) ---
# PB_CONFIG_HOST=http://pocketbase:8090
# PB_CONFIG_COLLECTION=configs
# PB_CONFIG_APP=meal-bot

# --- Режим 2: локальный fallback (используется, только если PB_CONFIG_HOST не задан) ---
# Токен бота от @BotFather (обязательно для локального режима)
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# Путь к файлу SQLite (по умолчанию meals.db)
DB_PATH=meals.db

# Часовой пояс для дат в интерфейсе и CSV (по умолчанию локальный часовой пояс ОС)
# BOT_TIMEZONE=Europe/Moscow

# Через сколько записей приёмов пищи показывать кнопку взвешивания (по умолчанию 15)
# WEIGH_IN_INTERVAL=15
